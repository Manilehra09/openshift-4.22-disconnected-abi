options {
    listen-on port 53 { 127.0.0.1; <BASTION_CLUSTER_IP>; };
    listen-on-v6 port 53 { ::1; };
    allow-query { localhost; <CLUSTER_NETWORK>; };
    recursion yes;
    allow-recursion { localhost; <CLUSTER_NETWORK>; };
    dnssec-validation yes;
};

zone "example.com" IN {
    type master;
    file "forward";
};

zone "<REVERSE_ZONE>" IN {
    type master;
    file "reverse";
};
